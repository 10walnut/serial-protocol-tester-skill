{
  "schema_version": "serial_protocol.v1",
  "name": "Temperature Controller Demo / 温控器示例",
  "description": "A small Modbus-like protocol used to exercise host and device modes.",
  "serial": {
    "defaults": {
      "baudrate": 9600,
      "bytesize": 8,
      "parity": "N",
      "stopbits": 1,
      "timeout_ms": 300
    }
  },
  "commands": [
    {
      "id": "read_temperature",
      "name": "Read temperature / 读取温度",
      "description": "Read register 0x0000; the returned register value is 0.1 °C per count.",
      "request": {
        "encoding": "hex",
        "data": "01 03 00 00 00 01",
        "checksum": {
          "algorithm": "modbus_crc16",
          "append": true,
          "byte_order": "little"
        }
      },
      "response": {
        "encoding": "hex",
        "data": "01 03 02 00 FA",
        "checksum": {
          "algorithm": "modbus_crc16",
          "append": true,
          "byte_order": "little"
        },
        "decode": [
          {
            "name": "temperature",
            "label": "Temperature / 温度",
            "offset": 3,
            "length": 2,
            "type": "uint16",
            "byte_order": "big",
            "scale": 0.1,
            "unit": "°C"
          }
        ]
      },
      "auto_reply": true
    },
    {
      "id": "set_run_state",
      "name": "Set run state / 设置运行状态",
      "description": "Write register 0x0010. The sample value 1 means running.",
      "request": {
        "encoding": "hex",
        "data": "01 06 00 10 00 01",
        "checksum": {
          "algorithm": "modbus_crc16",
          "append": true,
          "byte_order": "little"
        },
        "match_mask": "FF FF FF FF 00 00 00 00"
      },
      "response": {
        "encoding": "hex",
        "data": "01 06 00 10 00 01",
        "checksum": {
          "algorithm": "modbus_crc16",
          "append": true,
          "byte_order": "little"
        },
        "decode": [
          {
            "name": "run_state",
            "label": "Run state / 运行状态",
            "offset": 4,
            "length": 2,
            "type": "uint16",
            "byte_order": "big",
            "enum": {
              "0": "Stopped / 停止",
              "1": "Running / 运行"
            }
          }
        ]
      },
      "auto_reply": true
    },
    {
      "id": "ascii_status",
      "name": "ASCII status / ASCII 状态",
      "description": "Demonstrates a line-oriented text command.",
      "baudrate": 115200,
      "request": {
        "encoding": "ascii",
        "data": "STATUS?\r\n"
      },
      "response": {
        "encoding": "ascii",
        "data": "OK,READY\r\n",
        "decode": [
          {
            "name": "status_text",
            "label": "Status / 状态",
            "offset": 0,
            "length": 8,
            "type": "ascii"
          }
        ]
      },
      "auto_reply": true
    }
  ]
}
